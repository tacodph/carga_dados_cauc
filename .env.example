# Banco transferepro (PostgreSQL). Nunca versionar o .env com a senha.
TRANSFEREPRO_DB_HOST=localhost
TRANSFEREPRO_DB_PORT=5433
TRANSFEREPRO_DB_NAME=transferepro
TRANSFEREPRO_DB_USER=
TRANSFEREPRO_DB_PASSWORD=

# Testes de integração rodam no próprio transferepro e TRUNCAM as tabelas cauc_*: só com CAUC_TESTE_BANCO=1

# Pastas locais (relativas à raiz do projeto)
CAUC_DATA_DIR=data

# Calendário: inclui pontos facultativos federais (Carnaval, Corpus Christi...) como dias não úteis
CAUC_FERIADOS_FACULTATIVOS=true
# Datas extras não úteis, separadas por vírgula (AAAA-MM-DD)
CAUC_FERIADOS_EXTRAS=

# Alertas: só modo dry-run (mensagens gravadas em data/alertas e em cauc_alerta, nada é enviado)
CAUC_ALERTA_JANELA_VENCIMENTO_DIAS=15
CAUC_ALERTA_VENCIMENTO_ATIVO=false
# Arquivo JSON opcional que sobrescreve limites das regras de qualidade (ver quality.LIMITES)
CAUC_DQ_LIMITES_JSON=

# Proxy corporativo, se houver (lido automaticamente pelo httpx)
# HTTPS_PROXY=http://proxy:3128
